# =====================================================================
# APEX EDGE — CONFIGURAZIONE LOCALE (.env)
# Compila i tuoi dati qui e salva il file come ".env" (NON va su GitHub!)
# =====================================================================

# Porta del server locale
PORT=8787

# Telegram Bot (per notifiche Live, Esiti FT e link Cloudflare all'avvio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
SEND_TUNNEL_URL_TO_TELEGRAM=true

# Betfair.it Exchange API (opzionale per quote dirette e piazzamento)
BETFAIR_APP_KEY=
BETFAIR_SSOID=

# PIN di accesso opzionale per proteggere l'app quando esposta via Cloudflare Tunnel
# Lascia vuoto per accesso diretto senza password
APEX_ACCESS_PIN=

# Percorso eseguibile cloudflared (lascia "cloudflared" se è nel PATH o nella stessa cartella)
CLOUDFLARED_PATH=cloudflared
